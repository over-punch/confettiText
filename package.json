{
	"name": "@overpunch/confettitext",
	"version": "3.0.0",
	"description": "Confetti cannon where every particle is a real letter from your text — a burst of DOM letter-spans with physics, variable-font weight jitter, and a canvas-confetti-familiar API",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"typesVersions": {
		"*": {
			"react": [
				"./dist/react.d.ts"
			]
		}
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./react": {
			"import": {
				"types": "./dist/react.d.ts",
				"default": "./dist/react.js"
			},
			"require": {
				"types": "./dist/react.d.cts",
				"default": "./dist/react.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build && node scripts/copy-dcts.mjs",
		"build:webflow": "vite build --config vite.webflow.config.ts",
		"test": "vitest",
		"test:run": "vitest run",
		"lint": "tsc --noEmit",
		"prepublishOnly": "npm run test:run && npm run build && npm run build:webflow"
	},
	"peerDependencies": {
		"react": ">=17"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.0.0",
		"@vitejs/plugin-react": "^4.0.0",
		"happy-dom": "^20.10.6",
		"next": "16.2.2",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.0.0",
		"vite-plugin-dts": "^4.0.0",
		"vitest": "^3.0.0"
	},
	"keywords": [
		"typography",
		"web-typography",
		"frontend",
		"liiift-studio",
		"confetti",
		"confetti-text",
		"text-confetti",
		"burst",
		"celebration",
		"party",
		"animation",
		"text-animation",
		"variable-font",
		"font-variation-settings",
		"particles",
		"physics",
		"zero-dependencies",
		"react",
		"typescript",
		"css"
	],
	"author": "Quinn Keaveney <quinn@liiift.studio>",
	"license": "MIT",
	"homepage": "https://confettitext.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Liiift-Studio/confettiText.git"
	},
	"bugs": {
		"url": "https://github.com/Liiift-Studio/confettiText/issues"
	},
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	}
}
